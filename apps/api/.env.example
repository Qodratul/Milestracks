NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=

# Local development: from repo root run docker compose -f infra/docker-compose.yml up -d.
DATABASE_URL="postgresql://milestride:milestride@127.0.0.1:5432/milestride"
# Local migrations use the same Postgres URL; set DIRECT_URL for Prisma Migrate.
DIRECT_URL="postgresql://milestride:milestride@127.0.0.1:5432/milestride"

# Supabase: set DATABASE_URL to Session Pooler (port 5432) for app queries.
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require
# DIRECT_URL=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# Nebius Fast Tier validated in Stage 7; override for a different account/model.
LLM_API_KEY=
LLM_TIMEOUT_MS=8000
LLM_FAST_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_MODEL_FAST=Qwen/Qwen3-30B-A3B-Instruct-2507
LLM_REASONING_BASE_URL=
LLM_MODEL_REASONING=
SENTRY_DSN=
# Routing: mock locally; configure GraphHopper credits/minute to your account plan (Free default: 20).
ROUTING_PROVIDER=mock
GRAPHOPPER_BASE_URL=https://graphhopper.com/api/1
GRAPHOPPER_API_KEY=
GRAPHOPPER_PROFILE=foot
GRAPHOPPER_TIMEOUT_MS=10000
GRAPHOPPER_CREDITS_PER_MINUTE=20

# Open-Meteo free API is for evaluation/non-commercial use; configure customer URL and key for production.
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_API_KEY=
OPEN_METEO_TIMEOUT_MS=8000

# Public Overpass is for low-volume evaluation; use an appropriately hosted service for production.
OSM_TAGS_PROVIDER=overpass
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_API_URL=https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT_MS=12000
OVERPASS_REQUEST_INTERVAL_MS=2000

# Upstash Redis TCP connection uses TLS (rediss://).
UPSTASH_REDIS_URL=

# Mystery Track jobs run in-process; DEMO_MODE uses deterministic mock routing.
DEMO_MODE=false
ROUTE_GENERATION_CONCURRENCY=2
ROUTE_GENERATION_STALE_AFTER_MS=120000

# Stub API endpoints are disabled by default; enable for local contract work.
STUB_MODE=false

# Optional target and bearer token for scripts/gpx-replay.ts.
MILESTRIDE_API_URL=http://127.0.0.1:3000/api/v1
MILESTRIDE_ACCESS_TOKEN=
