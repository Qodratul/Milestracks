              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const payload = pm.response.json();",
                  "const data = payload && payload.data;",
                  "pm.test('Logout confirms the session ended', function () { pm.expect(data.loggedOut).to.eql(true); });",
                  "if (pm.response.code === 200 && data && data.loggedOut === true) {",
                  "  pm.environment.unset('accessToken');",
                  "  pm.environment.unset('refreshToken');",
                  "  pm.environment.unset('userId');",
                  "}"
                ]
              }
            }
          ],
          "description": "Logout sesi refresh token setelah seluruh request protected selesai."
