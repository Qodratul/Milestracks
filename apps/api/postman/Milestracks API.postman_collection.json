              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "pm.test(\"Loadout returns 200 and both slots\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(payload.data).to.be.an(\"object\");",
                  "  [\"boostItemCode\", \"modifierItemCode\"].forEach(function (key) {",
                  "    pm.expect(payload.data).to.have.property(key);",
                  "    pm.expect(payload.data[key] === null || typeof payload.data[key] === \"string\").to.eql(true);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
