    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "X-Client-Version",
                "value": "{{clientVersion}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"{{userDisplayName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"locale\": \"{{locale}}\",\n  \"timezone\": \"{{timezone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns 201 Created', function () { pm.response.to.have.status(201); });",
                  "const payload = pm.response.json();",
                  "const data = payload && payload.data;",
                  "pm.test('Register returns a user and session tokens', function () {",
                  "  pm.expect(data).to.be.an(\"object\");",
                  "  pm.expect(data.user.id).to.be.a(\"string\");",
                  "  pm.expect(data.emailVerificationRequired).to.eql(false);",
                  "  pm.expect(data.accessToken).to.be.a(\"string\");",
                  "  pm.expect(data.refreshToken).to.be.a(\"string\");",
                  "});",
                  "if (pm.response.code === 201 && data && data.user && data.accessToken && data.refreshToken) {",
                  "  pm.environment.set('userId', data.user.id);",
                  "  pm.environment.set('accessToken', data.accessToken);",
                  "  pm.environment.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "description": "Membuat akun dan state game awal. Ganti userEmail jika akun tersebut sudah ada. Response sukses menyimpan userId, accessToken, dan refreshToken ke environment."
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "X-Client-Version",
                "value": "{{clientVersion}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"rememberMe\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const payload = pm.response.json();",
                  "const data = payload && payload.data;",
                  "pm.test('Login returns a user and session tokens', function () {",
                  "  pm.expect(data).to.be.an(\"object\");",
                  "  pm.expect(data.user.id).to.be.a(\"string\");",
                  "  pm.expect(data.emailVerificationRequired).to.eql(false);",
                  "  pm.expect(data.accessToken).to.be.a(\"string\");",
                  "  pm.expect(data.refreshToken).to.be.a(\"string\");",
                  "});",
                  "if (pm.response.code === 200 && data && data.user && data.accessToken && data.refreshToken) {",
                  "  pm.environment.set('userId', data.user.id);",
                  "  pm.environment.set('accessToken', data.accessToken);",
                  "  pm.environment.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "description": "Masuk ke akun yang sudah terdaftar. rememberMe diterima untuk kompatibilitas; masa refresh token MVP tetap 30 hari."
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "X-Client-Version",
                "value": "{{clientVersion}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const previousRefreshToken = pm.environment.get('refreshToken');",
                  "pm.test('Refresh returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const payload = pm.response.json();",
                  "const data = payload && payload.data;",
                  "pm.test('Refresh rotates the refresh token', function () {",
                  "  pm.expect(data).to.be.an(\"object\");",
                  "  pm.expect(data.accessToken).to.be.a(\"string\");",
                  "  pm.expect(data.refreshToken).to.be.a(\"string\").and.not.eql(previousRefreshToken);",
                  "});",
                  "if (pm.response.code === 200 && data && data.accessToken && data.refreshToken) {",
                  "  pm.environment.set('accessToken', data.accessToken);",
                  "  pm.environment.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "description": "Rotasi refresh token. Script test otomatis mengganti accessToken dan refreshToken lama di environment."
        }
      ],
      "description": "Register, login, dan refresh menyimpan accessToken/refreshToken yang dipakai endpoint protected. Jalankan Account and Config setelah autentikasi; jalankan Session cleanup setelah selesai. Refresh merotasi refreshToken."
    },
