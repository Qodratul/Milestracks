                  "const data = payload && payload.data;",
                  "pm.test('finish returns a supported run and integrity status', function () {",
                  "  pm.expect(data).to.be.an('object');",
                  "  pm.expect(data.status).to.be.oneOf(['completed', 'rejected']);",
                  "  pm.expect(data.integrity).to.be.oneOf(['clean', 'flagged', 'rejected']);",
                  "  if (data.status === 'rejected' || data.integrity === 'rejected') pm.expect(data.claimId).to.be.null;",
                  "  else pm.expect(data.claimId).to.be.a('string').and.not.empty;",
                  "});",
                  "if (data) {",
                  "  pm.environment.set('runStatus', data.status || '');",
                  "  pm.environment.set('runIntegrity', data.integrity || '');",
