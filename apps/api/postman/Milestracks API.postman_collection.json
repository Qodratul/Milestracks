    {
      "name": "Items and Loadout",
      "item": [
        {
          "name": "Get inventory",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "X-Client-Version",
                "value": "{{clientVersion}}"
              }
            ],
            "url": "{{baseUrl}}/me/inventory",
            "description": "Mengambil stok seluruh item dari konfigurasi aktif, termasuk status equipped."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "pm.test(\"Inventory returns 200 and the API list envelope\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(payload.data).to.be.an(\"array\").that.is.not.empty;",
                  "  pm.expect(payload.meta.nextCursor).to.eql(null);",
                  "  pm.expect(payload.meta.limit).to.eql(20);",
                  "});",
                  "pm.test(\"Inventory items expose stock and loadout state\", function () {",
                  "  payload.data.forEach(function (item) {",
                  "    pm.expect(item.itemCode).to.be.a(\"string\");",
                  "    pm.expect(item.name).to.be.a(\"string\");",
                  "    pm.expect(item.slot).to.be.oneOf([\"boost\", \"modifier\"]);",
                  "    pm.expect(item.ownedCount).to.be.a(\"number\").and.at.least(0);",
                  "    pm.expect(item.maxStock).to.be.a(\"number\").and.at.least(item.ownedCount);",
                  "    pm.expect(item.autoUse).to.eql(false);",
                  "    pm.expect(item.equipped).to.be.a(\"boolean\");",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get loadout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
