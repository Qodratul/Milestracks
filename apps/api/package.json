{
  "name": "api",
  "version": "1.0.0",
  "description": "Milestracks API MVP",
  "license": "ISC",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi": "tsx scripts/generate-openapi.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "prepare": "cd ../.. && husky",
    "test:domain:coverage": "vitest run --coverage",
    "simulate:economy": "tsx scripts/simulate-economy.ts",
    "grant:items": "tsx scripts/grant-items.ts",
    "spike:routing": "tsx scripts/spikes/routing.ts",
    "spike:llm-selector": "tsx scripts/spikes/llm-selector.ts",
    "seed:routes": "tsx scripts/seed-routes.ts",
    "gpx:generate": "tsx scripts/gpx-generate.ts",
    "gpx:replay": "tsx scripts/gpx-replay.ts",
    "gpx:analyze": "tsx scripts/gpx-analyze.ts",
    "gpx:fixtures": "tsx scripts/gpx-generate-fixtures.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/client": "6.19.0",
    "@sentry/node": "^11.9.0",
    "argon2": "^0.45.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "^18.0.8",
    "ejs": "^6.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "8.0.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.13",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.2",
    "openai": "^7.39.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.17.5",
    "swagger-ui-express": "^5.0.1",
    "ulid": "^3.0.2",
    "uuid": "^14.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "fast-xml-parser": "^5.11.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
